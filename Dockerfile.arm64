# ==============================================================================
# Native Judge0 for ARM64 (Apple Silicon M1/M2/M3)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build native ARM64 Isolate Sandbox
# ------------------------------------------------------------------------------
FROM ubuntu:22.04 AS isolate-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libcap-dev \
    libseccomp-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ioi/isolate.git /tmp/isolate && \
    cd /tmp/isolate && \
    make isolate && \
    install -d /dist/bin /dist/etc && \
    install -m 4755 isolate /dist/bin/isolate.bin && \
    sed 's|@BOXDIR@|/var/local/lib/isolate|g' default.cf.in > /dist/etc/isolate && \
    sed -i 's/# first_uid = 60000/first_uid = 60000/' /dist/etc/isolate && \
    sed -i 's/# first_gid = 60000/first_gid = 60000/' /dist/etc/isolate && \
    sed -i 's/# num_boxes = 1000/num_boxes = 1000/' /dist/etc/isolate && \
    sed -i 's/subid_user = isolate/# subid_user = isolate/' /dist/etc/isolate

# ------------------------------------------------------------------------------
# Stage 2: Native ARM64 Judge0 Runtime & Execution Environment
# ------------------------------------------------------------------------------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV JUDGE0_HOMEPAGE="https://judge0.com" \
    JUDGE0_SOURCE_CODE="https://github.com/judge0/judge0" \
    JUDGE0_MAINTAINER="Herman Zvonimir Došilović <hermanz.dosilovic@gmail.com>" \
    JUDGE0_VERSION="1.13.1" \
    PORT=2358 \
    RAILS_ENV=production

# Install system utilities, Ruby runtime, and the C++ toolchain.
#
# This image is deliberately C++-only: Gator++ is a C++ game and nothing in the
# submission path needs Java, Node, Go, Rust, or Python. Those toolchains were
# dropped because they are the bulk of the image and none of them is reachable
# from the C++ path -- see OPTIMIZATION_REPORT.md, section "C++-only ARM64
# worker image", for the measured size and idle-memory effect.
#
# Consequence, stated plainly: the seed is filtered to the languages this image
# can run (`SUPPORTED_LANGUAGE_IDS` in judge0-src/db/seeds.rb), so a submission
# in one of the dropped toolchains is refused by validation -- HTTP 422, naming
# the language -- instead of being accepted and handed back a shell "not found"
# as its compile output. The two files have to move together: recovery is to
# re-add the package to the list below, rebuild, re-probe the language's
# compile_cmd and run_cmd paths inside the container, and add its id back to
# that list.
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    cron \
    curl \
    unzip \
    libcap2 \
    libseccomp2 \
    libpq5 \
    libyaml-0-2 \
    ruby \
    ruby-dev \
    build-essential \
    libpq-dev \
    libyaml-dev \
    tzdata \
    # The C++ toolchain (ARM64 native). `build-essential` already pulls gcc,
    # g++ and make; they are named explicitly so the dependency is visible.
    gcc \
    g++ \
    dash \
    bash \
    locales \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# `dash` above is what /bin/sh resolves to on Ubuntu, and /bin/sh is the
# interpreter the isolate wrapper -- and every generated compile/run script that
# still uses the script path -- starts. `bash` is kept only as the fallback for
# language definitions whose command line is bash-specific.

ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Setup Isolate binary and config
COPY --from=isolate-builder /dist/bin/isolate.bin /usr/local/bin/isolate.bin
COPY --from=isolate-builder /dist/etc/isolate /usr/local/etc/isolate
RUN mkdir -p /var/local/lib/isolate /run/isolate/locks

# Install smart wrapper for isolate
COPY isolate-wrapper.sh /usr/local/bin/isolate
RUN chmod 755 /usr/local/bin/isolate && chmod 4755 /usr/local/bin/isolate.bin

# Create compatibility symlinks for the C++ compiler paths that Judge0's
# language definitions name. All three GCC version directories point at the one
# toolchain this image ships, which is what makes the C++ (GCC 7.4.0 / 8.3.0 /
# 9.2.0) entries in the seed interchangeable here.
RUN mkdir -p \
    /usr/local/gcc-9.2.0/bin /usr/local/gcc-8.3.0/bin /usr/local/gcc-7.4.0/bin \
    /usr/local/gcc-9.2.0/lib64 /usr/local/gcc-8.3.0/lib64 /usr/local/gcc-7.4.0/lib64 \
    /usr/local/bash-5.0/bin && \
    ln -sf /usr/bin/gcc /usr/local/gcc-9.2.0/bin/gcc && \
    ln -sf /usr/bin/g++ /usr/local/gcc-9.2.0/bin/g++ && \
    ln -sf /usr/bin/gcc /usr/local/gcc-8.3.0/bin/gcc && \
    ln -sf /usr/bin/g++ /usr/local/gcc-8.3.0/bin/g++ && \
    ln -sf /usr/bin/gcc /usr/local/gcc-7.4.0/bin/gcc && \
    ln -sf /usr/bin/g++ /usr/local/gcc-7.4.0/bin/g++ && \
    ln -sf /usr/lib/aarch64-linux-gnu /usr/local/gcc-9.2.0/lib64 && \
    ln -sf /usr/lib/aarch64-linux-gnu /usr/local/gcc-8.3.0/lib64 && \
    ln -sf /usr/lib/aarch64-linux-gnu /usr/local/gcc-7.4.0/lib64 && \
    ln -sf /bin/bash /usr/local/bash-5.0/bin/bash

# ------------------------------------------------------------------------------
# Precompiled header for the C++ compile path
# ------------------------------------------------------------------------------
# Gator++ submissions are C++ programs that include <iostream> almost without
# exception, and parsing it -- plus the <ostream>/<string> machinery it pulls in
# -- was measured at 190-290 ms of every cold compile. Precompiling it once here
# takes that cost out of every submission.
#
# A precompiled header is only usable by a compiler that matches it, so it is
# built here from this image's own toolchain, headers and defaults. The exact
# identity it has to match is:
#
#   architecture      aarch64 -- the only architecture this image builds for
#   compiler binary   /usr/bin/g++, the binary every /usr/local/gcc-*/bin/g++
#                     symlink above points at, i.e. the one the C++ language
#                     rows actually invoke
#   compiler version  whatever this base image ships (11.4.0 today)
#   C++ standard      the driver's default for C++ (gnu++17 on GCC 11), because
#                     the worker does not pass -std
#   flags             -O0 -pipe, the default compiler_options for C++
#   standard library  this image's libstdc++ headers, resolved by asking the
#                     compiler rather than hardcoding a version directory, so a
#                     base-image bump cannot leave a stale path behind
#
# A stale PCH cannot survive a toolchain change -- it is produced during the
# build, from the same layer the compiler comes from -- and it cannot be handed
# to a different compiler at run time, because the worker verifies its digest
# before offering it (see app/services/pch.rb).
#
# The canary is the part that fails the build instead of the student: `-H` marks
# a *consumed* precompiled header with '!', so if the production argv would not
# pick this PCH up, this RUN fails and no image is produced. A PCH that is
# unusable for any reason therefore cannot reach a submission.
#
# `-Winvalid-pch` is deliberately not part of the production argv: when a
# student passes their own compiler_options that invalidate the PCH, GCC falls
# back silently, and a warning about it would land in that student's compile
# output as if it were a diagnostic about their code.
#
# Recovery: rebuild. If the header path moves, the compiler's own `-M` lookup
# below follows it; if a `-std=` or another flag is ever added to the C++ compile
# path, rebuild the PCH with that same flag set, or drop `Pch` and accept the
# slower compile.
RUN set -eux; \
    mkdir -p /usr/local/pch/c++; \
    iostream=$(printf '#include <iostream>\n' | /usr/bin/g++ -x c++ -M - | tr ' ' '\n' | grep -m1 '/iostream$' || true); \
    test -n "$iostream" || { echo "PCH: could not resolve <iostream> through /usr/bin/g++; is g++ installed?"; exit 1; }; \
    /usr/bin/g++ -O0 -pipe -x c++-header "$iostream" -o /usr/local/pch/c++/iostream.gch; \
    printf '#include <iostream>\nint main() { return 0; }\n' > /tmp/pch_canary.cpp; \
    /usr/bin/g++ -O0 -pipe -I/usr/local/pch/c++ -H -o /tmp/pch_canary.bin /tmp/pch_canary.cpp 2>/tmp/pch_canary.err; \
    grep -q '^! /usr/local/pch/c++/iostream.gch$' /tmp/pch_canary.err; \
    cd /usr/local/pch/c++ && sha256sum iostream.gch > pch.sha256; \
    chmod 0644 iostream.gch pch.sha256; \
    rm -f /tmp/pch_canary.cpp /tmp/pch_canary.bin /tmp/pch_canary.err

WORKDIR /api

# Install bundler and gems
RUN gem install bundler:2.1.4

COPY judge0-src/Gemfile* ./
RUN bundle install

# Copy Judge0 application code
COPY judge0-src/ .

# Setup cron tasks
COPY judge0-src/cron /etc/cron.d/
RUN cat /etc/cron.d/* | crontab -

# Setup judge0 system user and permissions
RUN useradd -u 1000 -m -r judge0 && \
    echo "judge0 ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers && \
    mkdir -p /api/tmp /api/log && \
    chown -R judge0:judge0 /api /var/local/lib/isolate

EXPOSE 2358

USER judge0

ENTRYPOINT ["/api/docker-entrypoint.sh"]
CMD ["/api/scripts/server"]
